{
  "manifest_version": 3,
  "name": "AI 생기부 보조 생성기 → 나이스",
  "version": "0.2.0",
  "description": "AI 생기부 보조 생성기 웹앱에서 만든 교과 평어·행동특성·창체 특기사항을 나이스 화면에 번호순으로 자동 입력합니다. 학생 이름은 읽지 않고 서버와 통신하지 않습니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://989-alt.github.io/evaluationapp/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.neis.go.kr/*"
  ],
  "optional_host_permissions": [
    "https://*.go.kr/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "AI 생기부 → 나이스",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://989-alt.github.io/evaluationapp/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.neis.go.kr/*"
      ],
      "js": [
        "src/neis-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
